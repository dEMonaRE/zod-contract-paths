{
  "name": "@aemrezorlu/zod-contract-paths",
  "version": "0.2.1",
  "description": "File-based routing → OpenAPI paths plugin for zod-contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "keywords": [
    "zod",
    "openapi",
    "routing",
    "paths",
    "file-based-routing",
    "typescript",
    "zod-contract"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dEMonaRE/zod-contract-paths.git"
  },
  "bugs": {
    "url": "https://github.com/dEMonaRE/zod-contract-paths/issues"
  },
  "homepage": "https://github.com/dEMonaRE/zod-contract-paths#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "demo": "tsx test/demo.ts"
  },
  "dependencies": {
    "jiti": "^2.0.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@aemrezorlu/zod-contract": "^0.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@aemrezorlu/zod-contract": "file:../zod-contract",
    "@types/node": "^20.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
